#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
	/usr/libexec/rpcd/pol prepare || return 1
 /usr/libexec/rpcd/pol start-epoch || return 1
	procd_open_instance core
	procd_set_param command /usr/lib/pol/pol-core run -config /var/run/pol/xray.json
	procd_set_param respawn 3600 5 5
 procd_set_param term_timeout 1
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /var/run/pol/xray.json
	procd_set_param env "XRAY_LOCATION_ASSET=$(/usr/libexec/rpcd/pol geo-directory)"
	procd_close_instance
 if [ -s /var/run/pol/dnsmasq.conf ]; then
 procd_open_instance resolver
 procd_set_param command /usr/sbin/dnsmasq --keep-in-foreground --conf-file=/var/run/pol/dnsmasq.conf
 procd_set_param respawn 3600 5 5
 procd_set_param term_timeout 1
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
 fi
 procd_open_instance monitor
 procd_set_param command /usr/libexec/rpcd/pol monitor
 procd_set_param term_timeout 2
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}

service_started() {
	/usr/libexec/rpcd/pol network-start || { stop; return 1; }
}

stop_service() {
 if [ "$action" = restart ]; then
 /usr/libexec/rpcd/pol network-pause
 else
 /usr/libexec/rpcd/pol network-stop
 fi
}
